# ============================================================================
# DropDeck — tambahkan/ubah blok ini pada .env.example & .env proyek Laravel 13
# (nilai di bawah untuk LOKAL via podman compose; produksi diisi di Dokploy)
# ============================================================================
APP_NAME=DropDeck
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# --- Database (MariaDB) ------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=dropdeck
DB_USERNAME=dropdeck
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# --- Session / Cache / Queue (driver database) -------------------------------
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Storage (RustFS, S3-compatible) -----------------------------------------
FILESYSTEM_DISK=vault
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=dropdeck
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Google OAuth (Socialite) ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Mail (Mailpit lokal) ----------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@dropdeck.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Batas bisnis DropDeck (lihat PRD bagian 7) ------------------------------
DROPDECK_QUOTA_MB=2048
DROPDECK_MAX_FILE_MB=100
DROPDECK_MAX_FILES_PER_CARD=20
DROPDECK_MAX_BOARDS=20
DROPDECK_MAX_COLUMNS=15
DROPDECK_MAX_CARDS_PER_BOARD=500
DROPDECK_MAX_LABELS=20
DROPDECK_MAX_CHECKLIST=50
DROPDECK_MAX_ACTIVE_LINKS=100
DROPDECK_LINK_MAX_DAYS=30
DROPDECK_LINK_MAX_DL=100
DROPDECK_LOG_RETENTION_DAYS=90
DROPDECK_LINK_RETENTION_DAYS=30
THUMBNAIL_PDF_ENABLED=false

# --- Produksi (Dokploy) — ganti nilainya ------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://dropdeck.contoh.com
# LOG_CHANNEL=stderr
# Gunakan password kuat untuk DB_* dan AWS_* (service account RustFS khusus aplikasi).
